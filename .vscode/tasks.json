{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动后端服务器",
      "type": "shell",
      "command": "python",
      "args": ["main.py"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": [],
      "detail": "启动FastAPI后端服务器"
    },
    {
      "label": "启动前端开发服务器",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": [],
      "detail": "启动Vue.js前端开发服务器"
    },
    {
      "label": "启动完整项目",
      "dependsOn": ["启动后端服务器", "启动前端开发服务器"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "同时启动前后端服务器"
    },
    {
      "label": "停止所有服务器",
      "type": "shell",
      "command": "echo",
      "args": ["请手动停止终端中的服务器进程"],
      "group": "build",
      "detail": "停止所有运行中的服务器（需要手动操作）"
    },
    {
      "label": "检查项目状态",
      "type": "shell",
      "command": "echo",
      "args": [
        "后端健康检查: http://localhost:8000/health",
        "前端开发服务器: http://localhost:3000",
        "API文档: http://localhost:8000/docs"
      ],
      "group": "test",
      "detail": "显示项目运行状态和访问地址"
    }
  ]
}